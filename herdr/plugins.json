    "plugin_id": "third774.last-workspace",
    "name": "Last Workspace",
    "version": "0.1.0",
    "min_herdr_version": "0.7.0",
    "description": "Toggle between the current and previously focused Herdr workspace.",
    "manifest_path": "/home/fzymorn/.config/herdr/plugins/github/third774.last-workspace-5de7aeab3665/herdr-plugin.toml",
    "plugin_root": "/home/fzymorn/.config/herdr/plugins/github/third774.last-workspace-5de7aeab3665",
    "enabled": true,
    "platforms": [
      "linux",
      "macos"
    ],
    "build": [
      {
        "platforms": [
          "linux",
          "macos"
        ],
        "command": [
          "cargo",
          "build",
          "--release"
        ]
      }
    ],
    "actions": [
      {
        "id": "toggle",
        "title": "Last workspace",
        "contexts": [
          "global",
          "workspace"
        ],
        "command": [
          "./target/release/herdr-last-workspace",
          "toggle"
        ]
      }
    ],
    "events": [
      {
        "on": "workspace.closed",
        "command": [
          "./target/release/herdr-last-workspace",
          "closed"
        ]
      },
      {
        "on": "workspace.focused",
        "command": [
          "./target/release/herdr-last-workspace",
          "focused"
        ]
      }
    ],
    "source": {
      "kind": "github",
